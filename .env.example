# Copy to .env, or let deploy/generate_secrets.py create it for you:
#     python3 deploy/generate_secrets.py --domain clinic.example.com
# NEVER commit .env. Keep comments on their own lines (no trailing comments).

# ---- Secrets (filled in by generate_secrets.py) ----
DJANGO_SECRET_KEY=
FIELD_ENCRYPTION_KEYS=
POSTGRES_PASSWORD=
DATABASE_URL=

# ---- Site ----
POSTGRES_DB=clinic
POSTGRES_USER=clinic
DJANGO_ALLOWED_HOSTS=clinic.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://clinic.example.com
SITE_URL=https://clinic.example.com
# Emergency Django back-office path (random; never /admin/).
DJANGO_ADMIN_URL=console-admin/
# 1 only when behind the bundled nginx / your own proxy that overwrites X-Forwarded-For.
TRUST_PROXY=1
TIME_ZONE=Asia/Kolkata
IDLE_TIMEOUT_MINUTES=30
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=30
DEFAULT_COUNTRY_CODE=91
# 0 disables the wa.me share buttons for prescriptions (no patient data leaves the system).
ENABLE_WHATSAPP_SHARE=1

# ---- Optional: e-mail the temporary password to new users (leave EMAIL_HOST empty to disable) ----
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=clinic@example.com
# Channels the admin may use to hand over a temporary password: email, whatsapp (comma-separated).
CREDENTIAL_DELIVERY=email,whatsapp
# Unused temporary passwords expire after this many hours.
TEMP_PASSWORD_HOURS=48
